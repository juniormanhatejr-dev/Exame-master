<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExameMaster">

        <!-- 1. Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ExameMaster.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Login Screen -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:label="@string/title_login" />

        <!-- 3. Register Screen -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:label="@string/title_register" />

        <!-- 4. Main Home Screen -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- 5. Universities Screen -->
        <activity
            android:name=".activities.UniversitiesActivity"
            android:exported="false"
            android:label="@string/title_universities"
            android:parentActivityName=".activities.MainActivity" />

        <!-- 6. Courses Screen -->
        <activity
            android:name=".activities.CoursesActivity"
            android:exported="false"
            android:label="@string/title_courses"
            android:parentActivityName=".activities.UniversitiesActivity" />

        <!-- 7. Subjects Screen -->
        <activity
            android:name=".activities.SubjectsActivity"
            android:exported="false"
            android:label="@string/title_subjects"
            android:parentActivityName=".activities.CoursesActivity" />

        <!-- 8. Exams Screen -->
        <activity
            android:name=".activities.ExamsActivity"
            android:exported="false"
            android:label="@string/title_exams"
            android:parentActivityName=".activities.SubjectsActivity" />

        <!-- 9. Interactive Quiz / Practice Screen -->
        <activity
            android:name=".activities.QuizActivity"
            android:exported="false"
            android:label="@string/title_quiz" />

        <!-- 10. Timed Exam / Simulation Screen -->
        <activity
            android:name=".activities.TimedQuizActivity"
            android:exported="false"
            android:label="@string/title_timed_quiz" />

        <!-- 11. Exam Result Screen -->
        <activity
            android:name=".activities.ExamResultActivity"
            android:exported="false"
            android:label="@string/title_exam_result" />

        <!-- 12. Study Manuals Library Screen -->
        <activity
            android:name=".activities.ManualsActivity"
            android:exported="false"
            android:label="@string/title_manuals"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Manual Detail Screen -->
        <activity
            android:name=".activities.ManualDetailActivity"
            android:exported="false"
            android:label="@string/title_manual_detail"
            android:parentActivityName=".activities.ManualsActivity" />

        <!-- 13. Video Lessons Screen -->
        <activity
            android:name=".activities.VideoLessonsActivity"
            android:exported="false"
            android:label="@string/title_video_lessons"
            android:parentActivityName=".activities.MainActivity" />

        <!-- 14. Student Profile Screen -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:label="@string/title_profile"
            android:parentActivityName=".activities.MainActivity" />

        <!-- 15. Performance History Screen -->
        <activity
            android:name=".activities.PerformanceHistoryActivity"
            android:exported="false"
            android:label="@string/title_performance_history"
            android:parentActivityName=".activities.MainActivity" />

    </application>

</manifest>
